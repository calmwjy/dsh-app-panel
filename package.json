{
  "name": "dsh-app-panel",
  "version": "0.1.0",
  "description": "DSH Web GUI 右侧「应用面板」：列出本会话装载的应用（MCP 服务器 / Cordis 插件 / 单个工具 / 技能）与各自的 token 体积，按会话勾选启用与否。",
  "type": "module",
  "license": "MIT",
  "author": "王景宇",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "mcp",
    "token",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/calmwjy/dsh-app-panel"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
